{
  "name": "seatreserve-frontend",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node scripts/generate-api-base.mjs && ng serve --port 5174 --proxy-config proxy.conf.json",
    "dev": "node scripts/generate-api-base.mjs && ng serve --port 5174 --proxy-config proxy.conf.json",
    "build": "node scripts/generate-api-base.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "ng test --watch=false"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^27.4.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
